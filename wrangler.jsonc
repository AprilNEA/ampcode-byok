/**
 * Wrangler config for ampcode-byok.
 *
 * One secret (`SHARED_SECRET`) authenticates the local amp CLI to this
 * worker. All other state — the real ampcode token and per-provider
 * base_url + api_key — lives in the `STORE` KV namespace and is set via
 * `PUT /__config/*` (or the admin UI at `/`).
 *
 * When deployed via the "Deploy to Cloudflare" button, the KV namespace
 * is auto-created (empty `id`). Set `SHARED_SECRET` after deploy with:
 *   wrangler secret put SHARED_SECRET
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ampcode-byok",
	"main": "src/index.tsx",
	"compatibility_date": "2026-05-14",
	"observability": { "enabled": true },
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "STORE"
		}
	]
	/**
	 * SHARED_SECRET defaults to a plain Worker secret declared in
	 * `.dev.vars.example`; the Deploy button prompts the user for it
	 * and the worker reads it as `env.SHARED_SECRET: string`.
	 *
	 * Alternatively, bind it to a Cloudflare Secrets Store entry — the
	 * worker resolves either shape via `await binding.get()` at runtime,
	 * so the application code does not change:
	 *
	 * "secrets_store_secrets": [
	 *   {
	 *     "binding": "SHARED_SECRET",
	 *     "store_id": "<your-store-id>",
	 *     "secret_name": "ampcode-byok-shared-secret"
	 *   }
	 * ]
	 */
}
