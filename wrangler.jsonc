/**
 * Wrangler config for ampcode-byok.
 *
 * One secret (`SHARED_SECRET`) authenticates the local amp CLI to this
 * worker. All other state — the real ampcode token and per-provider
 * base_url + api_key — lives in the `STORE` KV namespace and is set via
 * `PUT /__config/*` (or `wrangler kv key put`).
 *
 * Setup:
 *   wrangler kv namespace create STORE        # paste the id below
 *   wrangler secret put SHARED_SECRET         # the value amp CLI will send
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ampcode-byok",
	"main": "src/index.tsx",
	"compatibility_date": "2026-05-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "STORE",
			"id": "REPLACE_WITH_KV_NAMESPACE_ID"
		}
	]
}
